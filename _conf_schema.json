{
  "auto_install_on_startup": {
    "description": "启动时自动安装缺失的捆绑插件",
    "type": "bool",
    "default": true,
    "hint": "开启后，Bot启动时会自动检查并安装未安装的捆绑插件"
  },
  "only_admin": {
    "description": "仅管理员可用本插件命令",
    "type": "bool",
    "default": true,
    "hint": "开启后仅管理员可执行 /zhalslar 命令"
  },
